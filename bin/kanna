#!/usr/bin/env bun
import { existsSync } from "node:fs"

// A checkout runs the source; the published package ships only the bundle
// (scripts/build-server.ts), so src/server isn't there to find.
const source = new URL("../src/server/entry.ts", import.meta.url)
await import(existsSync(source) ? source.href : new URL("../dist/server/entry.js", import.meta.url).href)
