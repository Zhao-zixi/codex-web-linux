<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Hardened runtime, no App Sandbox (electron-builder.yml says why). -->
<dict>
	<!-- V8 compiles JavaScript into executable memory. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- Dictation in the composer (getUserMedia). The hardened runtime ignores
	     NSMicrophoneUsageDescription without it. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
